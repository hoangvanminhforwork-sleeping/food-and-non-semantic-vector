{
  "name": "ICOCO_culture_representation",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  // Mount the workspace folder into the container
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  // Mount the project's local .cline folder into the container's root directory
  "mounts": [
    "source=${localWorkspaceFolder}/.cline,target=/root/.cline,type=bind",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance",
        "saoudrizwan.claude-dev" // Cline extension inside container
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  "remoteUser": "root"
}